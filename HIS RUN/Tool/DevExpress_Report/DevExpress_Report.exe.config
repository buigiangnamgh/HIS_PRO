<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
    </startup>

    <appSettings>
        <!-- Thư mục chứa các file .repx hiện ở màn hình chính (có thể chọn thư mục khác ngay trên màn hình).
             Đường dẫn tương đối tính từ thư mục file .exe; mặc định trỏ tới thư mục report của project
             BarcodePrintDemo nằm cạnh project này. Có thể trỏ thẳng tới thư mục report của hệ thống thật. -->
        <add key="ReportPath" value="..\..\..\BarcodePrintDemo\report" />
    </appSettings>
</configuration>
